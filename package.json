{
  "name": "grapesjs-context-menu",
  "version": "1.0.1",
  "description": "GrapesJS plugin: right-click context menu for the canvas and the Layer Manager (add block inside, select parent/child, reorder, move, clone, delete) plus a clickable hierarchy badge on the selected element.",
  "type": "module",
  "main": "./dist/grapesjs-context-menu.umd.cjs",
  "module": "./dist/grapesjs-context-menu.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/grapesjs-context-menu.js",
      "require": "./dist/grapesjs-context-menu.umd.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run check:package && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "grapesjs": ">=0.21.0 <1.0.0"
  },
  "devDependencies": {
    "grapesjs": "0.21.13",
    "jsdom": "^25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "grapesjs",
    "grapesjs-plugin",
    "context-menu",
    "right-click",
    "layer-manager",
    "layers",
    "breadcrumbs"
  ],
  "author": "Alexander Shibisty",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shibisty/grapesjs-context-menu.git"
  },
  "bugs": {
    "url": "https://github.com/shibisty/grapesjs-context-menu/issues"
  },
  "homepage": "https://github.com/shibisty/grapesjs-context-menu#readme"
}
